# Copy this file to .env beside compose.yml on EACH Linux server.
# Children only need the general settings; everything marked HUB ONLY is ignored.
# With HUB=false, Compose runs only prom/node-exporter (image set in compose.yml).
# The existing validator and host SSH daemon continue running independently.
# Children do NOT run CONTROL_IMAGE; the hub runs it to generate configuration
# and open outbound monitoring tunnels. Child names/endpoints are set on the hub.

# ==================== GENERAL — EVERY SERVER ====================
# Only literal true or false. Plain `docker compose up -d` selects this role.
# Hub: true. Children: false.
HUB=false
# Keep this automatic mapping unchanged; edit only HUB to select the role.
COMPOSE_PROFILES=${HUB:-false}

# Host metrics exporter on this server (hub or child), bound to loopback.
# This is separate from any existing :9103 exporter.
# For a child, match this value in the hub's CHILDREN node_port field.
NODE_EXPORTER_PORT=19103

# ==================== HUB ONLY — LOCAL VALIDATOR METRICS ====================
# true: monitor a local validator plus CHILDREN (default for existing installs).
# false: this hub has no validator; list every validator in CHILDREN instead.
# Ignored on children. Supported from v0.5.0.
LOCAL_VALIDATOR_ENABLED=true
# These three local settings are ignored when LOCAL_VALIDATOR_ENABLED=false.
# Child identities are always set in CHILDREN below.
VC_ID=validator-1
VC_NAME='VC 1 - Hub'
# Existing Nimbus validator metrics on the hub (not the beacon REST API).
VC_METRICS_ADDRESS=127.0.0.1:8808

# ==================== HUB ONLY — CHILD METRICS CONNECTIONS ====================
# Leave empty on children. On the hub, replace [] with its child list.
# With LOCAL_VALIDATOR_ENABLED=false, at least one child is required, and
# validator-1 may be used by a child. No hub CSV or extra VC row is created.
CHILDREN=[]

# Example for a hub monitoring two children (uncomment and replace CHILDREN above):
# JSON list; one entry per child. local_port and local_port+1 must be free on
# the hub. vc_address/node_address are reached from the CHILD's SSH server.
# host is the child's real SSH DNS/IP, not a metrics-tunnel bind address.
# Match node_port to that child's NODE_EXPORTER_PORT. Keep each id/local_port stable.
# CHILDREN='[{"id":"validator-2","name":"VC 2 - Child 2","host":"REPLACE_CHILD_2_SSH_HOST","user":"lido-monitor","port":22,"local_port":20000,"vc_address":"127.0.0.1","vc_port":8808,"node_address":"127.0.0.1","node_port":19103},{"id":"validator-3","name":"VC 3 - Child 3","host":"REPLACE_CHILD_3_SSH_HOST","user":"lido-monitor","port":22,"local_port":20002,"vc_address":"127.0.0.1","vc_port":8808,"node_address":"127.0.0.1","node_port":19103}]'

# ==================== HUB ONLY — SSH FILES ====================
# Existing files on the hub, mounted read-only. Key contents never go in .env.
# This unattended key must work without a passphrase prompt. known_hosts must
# already contain independently verified keys for these DNS names/SSH ports.
SSH_KEY_FILE=/absolute/path/to/monitoring_key
SSH_KNOWN_HOSTS_FILE=/absolute/path/to/known_hosts

# ==================== HUB ONLY — SHARED MAIN SERVER METRICS ====================
# Address on the hub where the existing main AND fallback SSH forwards bind.
BACKEND_ADDRESS=REPLACE_WITH_HUB_TUNNEL_BIND_IP
MAIN_BEACON_PORT=18008
MAIN_EXECUTION_PORT=19105
MAIN_EXECUTION_PATH=/metrics
MAIN_HOST_PORT=49103

# ==================== HUB ONLY — SHARED FALLBACK SERVER METRICS ====================
# Uses BACKEND_ADDRESS above. Geth's metrics path differs from Nethermind's.
FALLBACK_BEACON_PORT=28008
FALLBACK_EXECUTION_PORT=29105
FALLBACK_EXECUTION_PATH=/debug/metrics/prometheus
FALLBACK_HOST_PORT=59103

# ==================== HUB ONLY — ACTIVE VALIDATORS / BALANCES (OPTIONAL) ====================
# One headerless CSV per VC in this hub directory: validator-1.csv, validator-2.csv, etc.
# One full 0x-prefixed public key per line. No private keys or keystores.
# Disabled until inventories are supplied; active/balance panels then show No data.
INVENTORY_ENABLED=false
INVENTORY_DIR=./inventory
INVENTORY_PORT=19200
# Beacon REST API forwards on BACKEND_ADDRESS (NOT metrics ports).
MAIN_BEACON_API_PORT=5052
FALLBACK_BEACON_API_PORT=5552

# ==================== HUB ONLY — GRAFANA ====================
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
GRAFANA_PORT=3200

# ==================== HUB ONLY — PROMETHEUS ====================
PROMETHEUS_PORT=9092
SCRAPE_INTERVAL=30s
PROMETHEUS_RETENTION=7d
PROMETHEUS_RETENTION_SIZE=2GB

# ==================== HUB ONLY — CONTROL IMAGE ====================
# This is the configuration/tunnel controller, not the child's host exporter.
# Published on version-tag pushes; branch pushes do not publish images.
# Prefer a version tag or image digest for deliberate production upgrades.
CONTROL_IMAGE=ghcr.io/owlofmoistness/lido-grafana:0.5.0
CONTROL_PULL_POLICY=always
# For a prebuilt local image: CONTROL_IMAGE=lido-fleet-control:local
# and CONTROL_PULL_POLICY=never (build it explicitly from a source checkout).
