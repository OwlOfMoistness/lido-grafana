# Copy this file to .env in the repository root on EACH Linux server.
# Only literal true or false. Plain `docker compose up -d` selects this role.
# Hub: true. Children: false.
HUB=false

# VC 1 = hub, VC 2/3 = children.
# The hub uses VC_ID/VC_NAME for its own metrics. Child identities are in CHILDREN.
VC_ID=validator-1
VC_NAME='VC 1 - Hub'

# A NEW loopback-only exporter, alongside any existing :9103 exporter.
# Use the same value in each child's node_port entry below if you change it.
NODE_EXPORTER_PORT=19103

# ---- Hub-only settings below; children do not load them. ----
# Existing Nimbus validator metrics on the hub (not the beacon REST API).
VC_METRICS_ADDRESS=127.0.0.1:8808
# Set this to the hub's existing private SSH bind address.
BACKEND_ADDRESS=REPLACE_WITH_HUB_TUNNEL_BIND_IP
MAIN_BEACON_PORT=18008
MAIN_EXECUTION_PORT=19105
MAIN_HOST_PORT=49103
FALLBACK_BEACON_PORT=28008
FALLBACK_EXECUTION_PORT=29105
FALLBACK_HOST_PORT=59103
MAIN_EXECUTION_PATH=/metrics
FALLBACK_EXECUTION_PATH=/debug/metrics/prometheus

# JSON list; one entry per child. local_port and local_port+1 must be free on
# the hub. vc_address/node_address are reached from the CHILD's SSH server.
# host is the child's real SSH DNS/IP, not a metrics-tunnel bind address.
# Match node_port to that child's NODE_EXPORTER_PORT. Keep each id/local_port stable.
CHILDREN='[{"id":"validator-2","name":"VC 2 - Child 2","host":"REPLACE_CHILD_2_SSH_HOST","user":"REPLACE_SSH_USER","port":22,"local_port":20000,"vc_address":"127.0.0.1","vc_port":8808,"node_address":"127.0.0.1","node_port":19103},{"id":"validator-3","name":"VC 3 - Child 3","host":"REPLACE_CHILD_3_SSH_HOST","user":"REPLACE_SSH_USER","port":22,"local_port":20002,"vc_address":"127.0.0.1","vc_port":8808,"node_address":"127.0.0.1","node_port":19103}]'

# Existing files on the hub, mounted read-only. Key contents never go in .env.
# This unattended key must work without a passphrase prompt. known_hosts must
# already contain independently verified keys for these DNS names/SSH ports.
SSH_KEY_FILE=/absolute/path/to/monitoring_key
SSH_KNOWN_HOSTS_FILE=/absolute/path/to/known_hosts

GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
GRAFANA_PORT=3200
PROMETHEUS_PORT=9092
SCRAPE_INTERVAL=30s
PROMETHEUS_RETENTION=7d
PROMETHEUS_RETENTION_SIZE=2GB

# Published on version-tag pushes. This image exists after pushing v1.0.0
# and its workflow completing successfully; branch pushes do not publish images.
# Prefer a version tag or image digest for deliberate production upgrades.
CONTROL_IMAGE=ghcr.io/owlofmoistness/lido-grafana:1.0.0
CONTROL_PULL_POLICY=always
# For local development instead: CONTROL_IMAGE=lido-fleet-control:local
# and CONTROL_PULL_POLICY=build.
