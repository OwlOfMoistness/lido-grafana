# Standalone Validator Watch: copy this file to .env beside compose.yml.
# No Lido Grafana checkout or deployment is needed. CSV inventories remain files.
# Never commit your populated .env or print it in shared logs.

# ==================== IMAGE AND STORAGE ====================
# Use an already-published version. For a local build: validator-watch:local.
WATCH_IMAGE=ghcr.io/owlofmoistness/validator-watch:0.7.0
INVENTORY_DIR=./inventory
RETENTION_DAYS=30
# Minimum rest after each historical attempt; live epochs take priority.
# Range: 60–86400 seconds. Failed epochs also get exponential retry backoff.
BACKFILL_INTERVAL_SECONDS=600

# ==================== BEACON CONNECTIONS ====================
# Designated fallback REST API, reachable from the monitoring host.
BEACON_URL=http://127.0.0.1:5552
# Optional primary readiness guard; empty disables it. No analytics use this URL.
PRIMARY_HEALTH_URL=

# ==================== GRAFANA ====================
# Separate Grafana, bound to loopback. Access through your private connection.
WATCH_GRAFANA_PORT=3306
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD

# ==================== DISCORD ====================
# Paste the webhook URL between single quotes. Empty disables sending.
# Environment values are visible to administrators who can inspect containers.
DISCORD_WEBHOOK_URL=''

# ==================== ALERT CONDITIONS ====================
# Affected duties per 1,000 checked attestation duties (any missing credit).
# Each duty counts once, even if all three components are missing. Range: >0–1000.
# 10 = 1%; 5 = 0.5%; 1 = 0.1%. Lower values alert more sensitively. Decimals allowed.
ATTESTATION_ISSUE_PER_THOUSAND=10
# Consecutive checked epochs at/above threshold to alert; below it to recover.
# Gaps and zero-duty epochs break streaks. Range: 1–32.
ATTESTATION_ISSUE_EPOCHS=2
# Alert if the running collector cannot collect for this long. Range: 30–86400.
# A stopped process/server requires an independent external uptime check.
COLLECTOR_ALERT_AFTER_SECONDS=300
# Confirmed missed proposals always alert when Discord is enabled.
# Clients crossing the attestation threshold together share one fleet message.

# ==================== OPTIONAL WEBHOOK FILE ====================
# Alternative to DISCORD_WEBHOOK_URL. Leave the URL empty when using a file.
# Put it in secrets/discord-webhook, readable by container UID 65532, then set:
# DISCORD_WEBHOOK_FILE=/run/secrets/discord-webhook
DISCORD_WEBHOOK_FILE=
SECRETS_DIR=./secrets
